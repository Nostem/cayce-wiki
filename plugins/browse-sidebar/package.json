{
  "name": "@cayce-wiki/browse-sidebar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "../../node_modules/.bin/esbuild src/index.ts src/components/index.ts --bundle --format=esm --outbase=src --outdir=dist --external:preact --external:@quartz-community/types && ../../node_modules/.bin/prettier --write dist"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.2.1"
  },
  "quartz": {
    "name": "browse-sidebar",
    "displayName": "Cayce Browse Sidebar",
    "description": "Lightweight navigation for major wiki collections and concepts.",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "components": {
      "BrowseSidebar": {
        "name": "browse-sidebar",
        "displayName": "Browse",
        "description": "Static navigation that avoids loading the full wiki inventory.",
        "version": "1.0.0",
        "defaultPosition": "left",
        "defaultPriority": 50
      }
    }
  }
}
